<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.s6r_sale_margin_threshold</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-danger">minimum_margin_violation</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div
                        class="badge rounded-pill text-bg-danger float-end fs-6 border-0"
                        invisible="not minimum_margin_violation"
                >Minimum Margin Violation
                </div>
            </xpath>
        </field>
    </record>
    <record id="sale_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.s6r_sale_margin_threshold</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">minimum_margin_violation</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_sales_order_filter_inherit" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.s6r_sale_margin_threshold</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="before">
                <separator/>
                <filter
                        string="Minimum Margin Violation"
                        domain="[('minimum_margin_violation', '=', True)]"
                        name="minimum_margin_violation_filter"
                />

            </xpath>
        </field>
    </record>
</odoo>
