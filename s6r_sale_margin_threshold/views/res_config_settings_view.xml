<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="res_config_settings_view_form_sale_margin" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.s6r_sale_margin_threshold</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting
                        id="sale_min_margin"
                >
                    <field name="blocking_transaction_order"/>
                    <div class="content-group" invisible="not blocking_transaction_order">
                        <div class="row mt16">
                            <label
                                    for="sale_min_margin_percent"
                                    string="Minimum Margin"
                                    class="col-lg-4 o_light_label"
                            />
                            <field name="sale_min_margin_percent" widget="percentage"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>